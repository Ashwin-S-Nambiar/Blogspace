---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base title={`Not found · ${site.name}`} description="Nothing to inspect here." noindex>
  <section class="lost">
    <p class="code" data-in style="--i:1">404</p>
    <h1 data-in style="--i:2">Nothing to inspect here</h1>
    <p data-in style="--i:3">The link may be old, or the post has moved.</p>
    <a class="back" href="/" data-in style="--i:4">
      <svg class="ic" aria-hidden="true"><use href="#i-back"></use></svg>
      All writing
    </a>
  </section>
</Base>
