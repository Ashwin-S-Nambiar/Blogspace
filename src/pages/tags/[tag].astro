---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { allPosts, type Post, tagCounts, tagLabel, tagName } from '../../lib/posts';
import { site } from '../../site';

export async function getStaticPaths() {
  const posts = await allPosts();
  return tagCounts(posts).map(([tag]) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  posts: Post[];
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`${tagLabel(tag)} · ${site.name}`} description={`Write-ups tagged ${tagName(tag)} on ${site.name}.`}>
  <section class="intro">
    <h1 data-in style="--i:1">{site.tagline}</h1>
  </section>
  <PostList posts={posts} tag={tag} />
</Base>
