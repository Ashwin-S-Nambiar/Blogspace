---
import { Font } from 'astro:assets';
import FontPreloads from '../components/FontPreloads.astro';
import Sprite from '../components/Sprite.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  compact?: boolean;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  issue?: string;
}

const {
  title,
  description,
  compact = false,
  image = '/og.jpg',
  imageAlt = 'BlogSpace: write-ups on the things I build, printed like a riso zine in blue and fluorescent pink',
  type = 'website',
  noindex = false,
  issue,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const home = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en" class={compact ? 'compact' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f6f2" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="BlogSpace" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="BlogSpace" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <FontPreloads />
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-read" />
    <Font cssVariable="--font-mono" />
    <style is:inline>html,body{background:#f7f6f2}</style>
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        const show = () => d.classList.add('ready');
        addEventListener('pagereveal', (e) => {
          if (e.viewTransition) d.classList.add('ready', 'instant');
        });
        Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 600))]).then(show);
      })();
    </script>
  </head>
  <body>
    <Sprite />
    <div class="page">
      <header class="top">
        <a class="mast" href="/" aria-label="BlogSpace, all posts" aria-current={home ? 'page' : undefined}>
          <span class="mast-p" aria-hidden="true">BlogSpace</span><span class="mast-b">BlogSpace</span>
        </a>
        {issue && (
          <p class="issue">
            <span>{issue}</span>
            <span class="issue-line">Write-ups on the things I build.</span>
          </p>
        )}
      </header>
      <main>
        <slot />
      </main>
      <footer class="credit">
        <span>Printed in two inks. <a href="/rss.xml">RSS</a></span>
        <span class="credit-end">
          <span>Made by <a href="https://ashwin.co.in" rel="noopener">Ashwin</a></span>
        </span>
      </footer>
    </div>
    <script>
      import { initTips } from '../lib/tip';
      initTips();
    </script>
  </body>
</html>
