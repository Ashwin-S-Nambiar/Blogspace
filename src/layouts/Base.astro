---
import { Font } from 'astro:assets';
import FontPreloads from '../components/FontPreloads.astro';
import Sprite from '../components/Sprite.astro';
import { site } from '../site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og.jpg?v=2',
  imageAlt = `${site.name}: ${site.tagline.toLowerCase()}`,
  type = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(`${Astro.url.pathname.replace(/\/$/, '')}/`, Astro.site);
const ogImage = new URL(image, Astro.site);
const projectCard = ogImage.pathname === '/og.jpg' || ogImage.pathname.startsWith('/og/posts/');
const home = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {projectCard && <meta property="og:image:type" content="image/jpeg" />}
    {projectCard && <meta property="og:image:width" content="1200" />}
    {projectCard && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <FontPreloads />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-serif" />
    <Font cssVariable="--font-mono" />
    <style is:inline>html,body{background:#fbfbfa}@media (prefers-color-scheme:dark){html,body{background:#111110}}</style>
    <link rel="expect" href="#end" blocking="render" />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        const show = () => d.classList.add('ready');
        const managed = 'onpagereveal' in window && 'navigation' in window;
        if (managed) history.scrollRestoration = 'manual';
        const save = () => {
          try {
            history.replaceState({ ...history.state, y: scrollY }, '');
          } catch {}
        };
        const unname = (other) => {
          const path = other ? new URL(other).pathname : '';
          const post = path.startsWith('/posts/');
          d.classList.toggle('vt-post', post);
          for (const t of document.querySelectorAll('.row-t')) {
            t.classList.toggle('vt-keep', post && new URL(t.closest('a').href).pathname === path);
          }
          for (const t of document.querySelectorAll('.vt-solo')) t.classList.remove('vt-solo');
        };
        const seen = (el) => {
          const r = el.getBoundingClientRect();
          return r.top >= 0 && r.bottom <= innerHeight;
        };
        const heroes = () => document.querySelectorAll('.row-t.vt-keep, .post-title');
        addEventListener('pageswap', (e) => {
          save();
          if (!e.viewTransition) return;
          unname(e.activation?.entry?.url);
          for (const t of heroes()) if (!seen(t)) t.classList.add('vt-solo');
        });
        addEventListener('pagehide', save);
        addEventListener('pagereveal', (e) => {
          if (e.viewTransition) d.classList.add('ready', 'instant');
          if (!managed) return;
          const act = navigation.activation;
          if (e.viewTransition) unname(act?.from?.url);
          const type = act?.navigationType;
          if (e.viewTransition && e.viewTransition.types) {
            const back = type === 'traverse' && act.entry && act.from && act.entry.index < act.from.index;
            e.viewTransition.types.add(back ? 'back' : 'forward');
          }
          const y = history.state?.y;
          if ((type === 'traverse' || type === 'reload') && typeof y === 'number') scrollTo(0, y);
          else if (!location.hash) scrollTo(0, 0);
          if (!e.viewTransition) return;
          const row = document.querySelector('.row-t.vt-keep');
          if (row && !seen(row)) {
            const r = row.getBoundingClientRect();
            scrollTo(0, Math.max(0, scrollY + r.top - (innerHeight - r.height) / 2));
          }
          for (const t of heroes()) if (!seen(t)) t.classList.add('vt-solo');
          e.viewTransition.ready.then(pace, () => {});
        });
        const pace = () => {
          const title = d
            .getAnimations({ subtree: true })
            .filter((a) => a.effect?.pseudoElement?.includes('(title-'));
          const group = title.find((a) => a.effect.pseudoElement.startsWith('::view-transition-group'));
          if (!group) return;
          const [from, to] = [group.effect.getKeyframes()[0], group.effect.getKeyframes().at(-1)].map(
            (k) => new DOMMatrix(k.transform),
          );
          const far = Math.hypot(to.e - from.e, to.f - from.f);
          const duration = Math.min(600, Math.max(360, 320 + far * 0.3));
          for (const a of title) a.effect.updateTiming({ duration });
        };
        const css = getComputedStyle(d);
        const first = (v) => css.getPropertyValue(v).split(',')[0].trim();
        const fonts = document.fonts
          ? Promise.all(['--font-sans', '--font-mono'].map((v) => document.fonts.load(`1em ${first(v)}`))).then(() => document.fonts.ready)
          : Promise.resolve();
        Promise.race([fonts, new Promise((r) => setTimeout(r, 600))]).then(show, show);
      })();
    </script>
  </head>
  <body>
    <Sprite />
    <div class="page">
      <header class="top">
        <a class="brand" href="/" aria-current={home ? 'page' : undefined}>
          <svg class="brand-mark" aria-hidden="true"><use href="#mark"></use></svg>
          <span class="brand-name">{site.name}</span>
        </a>
        <a class="rss" href="/rss.xml">
          <svg class="ic" aria-hidden="true"><use href="#i-rss"></use></svg>
          RSS
        </a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="credit">
        <span>Made by <a href={site.author} rel="noopener">Ashwin</a></span>
        <a href={site.source} rel="noopener">Source</a>
      </footer>
    </div>
    <span id="end" hidden></span>
    <script>
      import { initTips } from '../lib/tip';
      initTips();
    </script>
  </body>
</html>
