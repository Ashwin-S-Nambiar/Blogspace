---
import { Font } from 'astro:assets';
import FontPreloads from '../components/FontPreloads.astro';
import Sprite from '../components/Sprite.astro';
import { site } from '../site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og.jpg',
  imageAlt = `${site.name}: ${site.tagline.toLowerCase()}`,
  type = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const home = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <FontPreloads />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-serif" />
    <Font cssVariable="--font-mono" />
    <style is:inline>html,body{background:#fbfbfa}@media (prefers-color-scheme:dark){html,body{background:#111110}}</style>
    <link rel="expect" href="#end" blocking="render" />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        const show = () => d.classList.add('ready');
        const managed = 'onpagereveal' in window && 'navigation' in window;
        if (managed) history.scrollRestoration = 'manual';
        const save = () => {
          try {
            history.replaceState({ ...history.state, y: scrollY }, '');
          } catch {}
        };
        addEventListener('pageswap', save);
        addEventListener('pagehide', save);
        addEventListener('pagereveal', (e) => {
          if (e.viewTransition) d.classList.add('ready', 'instant');
          if (!managed) return;
          const act = navigation.activation;
          const type = act?.navigationType;
          if (e.viewTransition && e.viewTransition.types) {
            const back = type === 'traverse' && act.entry && act.from && act.entry.index < act.from.index;
            e.viewTransition.types.add(back ? 'back' : 'forward');
          }
          const y = history.state?.y;
          if ((type === 'traverse' || type === 'reload') && typeof y === 'number') scrollTo(0, y);
          else if (!location.hash) scrollTo(0, 0);
        });
        const css = getComputedStyle(d);
        const first = (v) => css.getPropertyValue(v).split(',')[0].trim();
        const fonts = document.fonts
          ? Promise.all(['--font-sans', '--font-mono'].map((v) => document.fonts.load(`1em ${first(v)}`))).then(() => document.fonts.ready)
          : Promise.resolve();
        Promise.race([fonts, new Promise((r) => setTimeout(r, 600))]).then(show, show);
      })();
    </script>
  </head>
  <body>
    <Sprite />
    <div class="page">
      <header class="top">
        <a class="brand" href="/" aria-current={home ? 'page' : undefined}>
          <svg class="brand-mark" aria-hidden="true"><use href="#mark"></use></svg>
          <span class="brand-name">{site.name}</span>
        </a>
        <a class="rss" href="/rss.xml">
          <svg class="ic" aria-hidden="true"><use href="#i-rss"></use></svg>
          RSS
        </a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="credit">
        <span>Made by <a href={site.author} rel="noopener">Ashwin</a></span>
        <a href={site.source} rel="noopener">Source</a>
      </footer>
    </div>
    <span id="end" hidden></span>
    <script>
      import { initTips } from '../lib/tip';
      initTips();
    </script>
  </body>
</html>
