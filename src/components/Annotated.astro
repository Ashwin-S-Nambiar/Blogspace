---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Mark {
  x: number;
  y: number;
  w?: number;
  h?: number;
  note: string;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  marks: Mark[];
  caption?: string;
  narrow?: boolean;
}

const { src, alt, marks, caption, narrow = false } = Astro.props;
const pct = (n: number) => `${n}%`;
---

<figure class:list={['fig', 'annotated', { wide: !narrow }]} data-annotated>
  <div class="pan">
  <div class="shot">
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']} fallbackFormat="webp"
      widths={[640, 960, 1320, 1920]}
      sizes="(max-width: 719px) 760px, (min-width: 1400px) 1320px, calc(100vw - 32px)"
    />
    {marks.map((m, i) => (
      <>
        {m.w && m.h && (
          <span
            class="ring"
            data-i={i}
            style={{ left: pct(m.x), top: pct(m.y), width: pct(m.w), height: pct(m.h) }}
          />
        )}
        <button
          type="button"
          class="pin"
          data-i={i}
          data-tip={m.note}
          aria-label={`Note ${i + 1}: ${m.note}`}
          style={{ left: pct(m.x), top: pct(m.y) }}
        >
          {i + 1}
        </button>
      </>
    ))}
  </div>
  </div>
  <p class="hint" aria-hidden="true">Swipe the screenshot to see all of it</p>
  <figcaption>
    <ol class="notes">
      {marks.map((m, i) => (
        <li>
          <button type="button" data-i={i}>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <span>{m.note}</span>
          </button>
        </li>
      ))}
    </ol>
    {caption && <p class="cap">{caption}</p>}
  </figcaption>
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-annotated]')) {
    const pan = fig.querySelector<HTMLElement>('.pan');
    const parts = fig.querySelectorAll<HTMLElement>('[data-i]');
    const heat = (i: string | null) => {
      fig.toggleAttribute('data-hot', i !== null);
      for (const el of parts) el.classList.toggle('hot', el.dataset.i === i);
    };
    for (const el of parts) {
      el.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') heat(el.dataset.i ?? null);
      });
      el.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse') heat(null);
      });
      el.addEventListener('focus', () => heat(el.dataset.i ?? null));
      el.addEventListener('blur', () => heat(null));
    }
    for (const note of fig.querySelectorAll<HTMLElement>('.notes [data-i]')) {
      note.addEventListener('click', () => {
        const pin = fig.querySelector<HTMLElement>(`.pin[data-i="${note.dataset.i}"]`);
        heat(note.dataset.i ?? null);
        if (!pan || !pin || pan.scrollWidth <= pan.clientWidth) return;
        const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
        pan.scrollTo({ left: pin.offsetLeft - pan.clientWidth / 3, behavior: smooth ? 'smooth' : 'auto' });
      });
    }
  }
</script>

<style>
  .pan {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding: 2px;
    margin: -2px;
  }

  .hint {
    display: none;
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-2);
  }

  .shot {
    position: relative;
    box-shadow: 0 0 0 1.5px var(--ink);
    background: var(--sheet);
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
  }

  .ring {
    position: absolute;
    border: 2.5px solid var(--pink);
    border-radius: 10px 14px 9px 13px / 12px 9px 14px 10px;
    pointer-events: none;
    transition: opacity 180ms var(--out);
  }

  .pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink-deep);
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 0 0 2px var(--stock);
    transition: opacity 180ms var(--out);
  }

  .pin::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 2px var(--ink);
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .pin.hot::after {
    opacity: 1;
  }

  [data-hot] .ring:not(.hot),
  [data-hot] .pin:not(.hot) {
    opacity: 0.35;
  }

  figcaption {
    display: grid;
    gap: 12px;
    margin-top: 16px;
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    align-items: start;
    gap: 2px 20px;
    padding: 0;
    list-style: none;
  }

  .notes button {
    display: grid;
    width: calc(100% + 16px);
    text-align: left;
    grid-template-columns: 22px 1fr;
    gap: 10px;
    align-items: start;
    padding: 6px 8px;
    margin: 0 -8px;
    border-radius: 3px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink);
    transition: background-color 160ms ease;
  }

  .notes button.hot {
    background: var(--pink-tint);
    color: var(--ink-deep);
  }

  .n {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink-deep);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .notes button:not(.hot):hover {
      background: var(--hover);
    }
  }

  .cap {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-2);
  }

  @media (max-width: 719px) {
    .pan {
      margin-inline: calc(-1 * var(--gutter));
      padding: 2px var(--gutter);
      scrollbar-width: none;
    }

    .pan::-webkit-scrollbar {
      display: none;
    }

    .shot {
      width: 760px;
    }

    .hint {
      display: block;
    }
  }

  @media (max-width: 599px) {
    .pin {
      width: 22px;
      height: 22px;
      margin: -11px 0 0 -11px;
      font-size: 11px;
    }

    .ring {
      border-width: 2px;
    }
  }
</style>
