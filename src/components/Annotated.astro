---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Mark {
  x: number;
  y: number;
  w?: number;
  h?: number;
  note: string;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  marks: Mark[];
  caption?: string;
  narrow?: boolean;
}

const { src, alt, marks, caption, narrow = false } = Astro.props;
const pad = (i: number) => String(i + 1).padStart(2, '0');
const wide = !narrow && src.width / src.height > 1.2;
---

<figure class:list={['fig', 'annotated', { narrow, wide }]} data-annotated data-marks={JSON.stringify(marks.map(({ x, y, w, h }) => [x, y, w ?? 0, h ?? 0]))}>
  <div class="stage">
    <div class="stage-in">
      <div class="pan">
        <div class="media inspect shot">
          <Picture
            src={src}
            alt={alt}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[640, 960, 1280]}
            sizes={narrow ? '440px' : '(max-width: 660px) 760px, 620px'}
          />
          {marks.map((m, i) =>
            m.w && m.h ? (
              <span
                class:list={['box', { low: m.y < 9 }]}
                data-i={i}
                aria-hidden="true"
                style={{ '--x': m.x, '--y': m.y, '--w': m.w, '--h': m.h }}
              >
                <b>{pad(i)}</b>
              </span>
            ) : (
              <span class="pin" data-i={i} aria-hidden="true" style={{ '--x': m.x, '--y': m.y }}>{i + 1}</span>
            ),
          )}
        </div>
      </div>
    </div>
  </div>
  <ol class="notes">
    {marks.map((m, i) => (
      <li>
        <button type="button" class="note" data-i={i} aria-pressed="false">
          <span class="note-n">{pad(i)}</span>
          <span>{m.note}</span>
        </button>
      </li>
    ))}
  </ol>
  {caption && <figcaption class="cap">{caption}</figcaption>}
</figure>

<script>
  type Mark = [number, number, number, number];
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  for (const fig of document.querySelectorAll<HTMLElement>('[data-annotated]')) {
    const shot = fig.querySelector<HTMLElement>('.shot');
    const pan = fig.querySelector<HTMLElement>('.pan');
    if (!shot || !pan) continue;
    const marks = JSON.parse(fig.dataset.marks ?? '[]') as Mark[];
    const parts = [...shot.querySelectorAll<HTMLElement>('[data-i]')];
    const notes = [...fig.querySelectorAll<HTMLButtonElement>('.note')];
    let pinned = -1;
    let lit = -2;

    const light = (i: number) => {
      if (i === lit) return;
      lit = i;
      parts.forEach((p, j) => p.classList.toggle('on', j === i));
      notes.forEach((n, j) => {
        n.classList.toggle('on', j === i);
        n.setAttribute('aria-pressed', String(j === pinned));
      });
    };

    const hit = (e: PointerEvent | MouseEvent) => {
      const r = shot.getBoundingClientRect();
      const px = ((e.clientX - r.left) / r.width) * 100;
      const py = ((e.clientY - r.top) / r.height) * 100;
      let best = -1;
      let area = Number.POSITIVE_INFINITY;
      marks.forEach(([x, y, w, h], i) => {
        const inside = w
          ? px >= x && px <= x + w && py >= y && py <= y + h
          : Math.hypot(((px - x) / 100) * r.width, ((py - y) / 100) * r.height) < 26;
        const size = w ? w * h : 0;
        if (inside && size < area) {
          best = i;
          area = size;
        }
      });
      return best;
    };

    const reveal = (i: number) => {
      if (i < 0 || pan.scrollWidth <= pan.clientWidth) return;
      const [x, , w] = marks[i];
      const left = ((x + w / 2) / 100) * shot.clientWidth - pan.clientWidth / 2;
      pan.scrollTo({ left, behavior: reduced.matches ? 'auto' : 'smooth' });
    };

    shot.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !fine.matches) return;
      const i = hit(e);
      light(i >= 0 ? i : pinned);
    });
    shot.addEventListener('pointerleave', () => light(pinned));
    shot.addEventListener('click', (e) => {
      const i = hit(e);
      pinned = i === pinned ? -1 : i;
      lit = -2;
      light(pinned);
    });

    notes.forEach((n, i) => {
      n.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse' && fine.matches) light(i);
      });
      n.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse') light(pinned);
      });
      n.addEventListener('focus', () => {
        if (n.matches(':focus-visible')) light(i);
      });
      n.addEventListener('blur', () => light(pinned));
      n.addEventListener('click', () => {
        pinned = i === pinned ? -1 : i;
        lit = -2;
        light(pinned >= 0 ? pinned : fine.matches ? i : -1);
        reveal(pinned);
      });
    });
  }
</script>

<style>
  .narrow .stage,
  .narrow .notes {
    max-width: 440px;
    margin-inline: auto;
  }

  .pan {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .pan::-webkit-scrollbar {
    display: none;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
  }

  @media (max-width: 640px) {
    .wide .shot {
      width: 760px;
    }
  }
</style>
