---
import { passes } from '../lib/cover';

interface Props {
  seed: string;
  title: string;
  label?: string;
  only?: 'pink' | 'blue';
  print?: boolean;
  name?: string;
  class?: string;
}

const { seed, title, label, only, print = false, name, class: cls } = Astro.props;
const p = passes(seed, title);
const style = name ? `view-transition-name: ${name}; view-transition-class: hero` : undefined;
---

<div class:list={['cover', cls, { printing: print }]} style={style} aria-hidden="true">
  {only !== 'blue' && (
    <svg class="pass pass-p" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <g transform={`translate(${p.off})`} set:html={p.pink} />
    </svg>
  )}
  {only !== 'pink' && (
    <svg class="pass pass-b" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
      <g set:html={p.blue} />
    </svg>
  )}
  {label && <span class="cover-label">{label}</span>}
</div>

<style>
  .printing .pass {
    clip-path: inset(0 0 100% 0);
    animation: lay 560ms var(--drawer) 260ms forwards;
  }

  .printing .pass-b {
    animation-delay: 600ms;
  }

  .printing {
    animation: jolt 220ms var(--out) 1120ms;
  }

  @keyframes lay {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(-3%);
    }

    75% {
      clip-path: inset(0 0 0 0);
    }

    to {
      clip-path: inset(0 0 0 0);
      transform: none;
    }
  }

  @keyframes jolt {
    40% {
      transform: translateY(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .printing .pass {
      clip-path: none;
      animation: none;
    }
  }
</style>
