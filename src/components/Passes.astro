---
import Cover from './Cover.astro';

interface Props {
  seed: string;
  title: string;
  caption?: string;
}

const { seed, title, caption } = Astro.props;
---

<figure class="fig passes" data-passes>
  <div class="row">
    <div class="step">
      <Cover seed={seed} title={title} only="pink" />
      <p><span class="k">1</span>The pink pass</p>
    </div>
    <div class="step">
      <Cover seed={seed} title={title} only="blue" />
      <p><span class="k">2</span>The blue pass</p>
    </div>
    <div class="step both">
      <Cover seed={seed} title={title} />
      <p><span class="k">=</span>Both, off register</p>
    </div>
  </div>
  <figcaption>
    {caption && <p class="cap">{caption}</p>}
    <button type="button" class="reprint" data-reprint>Print it again</button>
  </figcaption>
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-passes]')) {
    const cover = fig.querySelector<HTMLElement>('.both .cover');
    fig.querySelector('[data-reprint]')?.addEventListener('click', () => {
      if (!cover) return;
      cover.classList.remove('printing');
      void cover.offsetWidth;
      cover.classList.add('printing');
    });
  }
</script>

<style>
  .row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .step {
    display: grid;
    gap: 8px;
  }

  p {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink);
  }

  .k {
    color: var(--pink-ink);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
  }

  .cap {
    flex: 1 1 260px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-2);
  }

  .reprint {
    height: 32px;
    padding: 0 12px;
    border-radius: 3px;
    background: var(--ink);
    color: var(--stock);
    font-family: var(--mono);
    font-size: 12px;
    transition: transform 160ms var(--out);
  }

  .reprint:active {
    transform: scale(0.97);
  }

  @media (max-width: 479px) {
    .row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .both {
      grid-column: 1 / -1;
    }
  }
</style>
