---
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<aside class="aside">
  <svg class="ic" aria-hidden="true"><use href="#i-info"></use></svg>
  <div>
    {label && <p class="label">{label}</p>}
    <slot />
  </div>
</aside>

<style>
  .aside {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--stage);
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  .ic {
    width: 16px;
    height: 16px;
    margin-top: 3px;
    color: var(--faint);
  }

  .label {
    margin-bottom: 2px;
    font-weight: 560;
    color: var(--strong);
  }

  .aside :global(p + p) {
    margin-top: 8px;
  }

  .aside :global(a) {
    text-decoration-color: var(--ul);
    text-underline-offset: 3px;
  }
</style>
