---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Cue {
  from: number;
  to: number;
  text: string;
  x?: number;
  y?: number;
  w?: number;
  h?: number;
}

interface Props {
  src: string;
  poster: ImageMetadata;
  label: string;
  length: number;
  cues?: Cue[];
  track?: readonly unknown[];
  caption?: string;
  narrow?: boolean;
}

const { src, poster, label, length, cues = [], track, caption, narrow = false } = Astro.props;
const still = await getImage({ src: poster, format: 'webp', width: Math.min(poster.width, 1440) });
const clock = (s: number) => `${Math.floor(s / 60)}:${(s % 60).toFixed(1).padStart(4, '0')}`;
const at = (s: number) => Math.min(100, (s / length) * 100);
const data = cues.map((c) => ({
  from: c.from,
  to: c.to,
  box: c.x !== undefined && c.y !== undefined ? [c.x, c.y, c.w ?? 0, c.h ?? 0] : null,
}));
---

<figure class:list={['fig', 'clip', { narrow }]} data-clip data-length={length} data-w={poster.width} data-h={poster.height}>
  <div class="stage">
    <div class="stage-in">
      <div class="media inspect" style={{ aspectRatio: `${poster.width} / ${poster.height}` }}>
        <video muted playsinline loop preload="metadata" poster={still.src} aria-label={label}>
          <source src={src} type="video/mp4" />
        </video>
        {cues.length > 0 && (
          <>
            <span class="box" aria-hidden="true"><b></b></span>
            <span class="pin" aria-hidden="true"></span>
          </>
        )}
      </div>
      <div class="bar">
        <button type="button" class="play" aria-label="Play" data-tip="Play" data-play>
          <svg class="ic ic-play" aria-hidden="true"><use href="#i-play"></use></svg>
          <svg class="ic ic-pause" aria-hidden="true"><use href="#i-pause"></use></svg>
        </button>
        <div class="track" role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax={length} aria-valuenow="0" aria-valuetext={clock(0)}>
          <span class="rail" aria-hidden="true">
            {cues.map((c) => (
              <span class="seg" style={{ left: `${at(c.from)}%`, width: `${at(c.to) - at(c.from)}%` }}></span>
            ))}
          </span>
          <span class="head" aria-hidden="true"></span>
          <span class="hair" aria-hidden="true"><span>{clock(0)}</span></span>
        </div>
        <span class="time" aria-hidden="true"><b>{clock(0)}</b> / {clock(length)}</span>
      </div>
    </div>
  </div>
  {cues.length > 0 && (
    <ol class="notes">
      {cues.map((c, i) => (
        <li>
          <button type="button" class="note" data-i={i}>
            <span class="note-n">{String(i + 1).padStart(2, '0')}</span>
            <span>{c.text}</span>
            <span class="note-t">{clock(c.from)}</span>
          </button>
        </li>
      ))}
    </ol>
  )}
  {caption && <figcaption class="cap">{caption}</figcaption>}
  <script type="application/json" set:html={JSON.stringify({ cues: data, track: track ?? null })} />
</figure>

<script>
  type Box = [number, number, number, number];
  type Data = { cues: { from: number; to: number; box: Box | null }[]; track: [number, Box][] | null };

  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const clock = (s: number) => `${Math.floor(s / 60)}:${(s % 60).toFixed(1).padStart(4, '0')}`;
  const pad = (n: number) => String(n + 1).padStart(2, '0');

  function sample(track: [number, Box][], t: number): Box {
    let i = 0;
    while (i < track.length - 1 && track[i + 1][0] <= t) i++;
    const [t0, a] = track[i];
    const next = track[i + 1];
    if (!next) return a;
    const k = Math.min(1, Math.max(0, (t - t0) / (next[0] - t0)));
    return a.map((v, j) => v + (next[1][j] - v) * k) as Box;
  }

  for (const fig of document.querySelectorAll<HTMLElement>('[data-clip]')) {
    const video = fig.querySelector('video');
    const play = fig.querySelector<HTMLButtonElement>('[data-play]');
    const track = fig.querySelector<HTMLElement>('.track');
    const head = fig.querySelector<HTMLElement>('.head');
    const hair = fig.querySelector<HTMLElement>('.hair');
    const hairText = hair?.querySelector('span');
    const time = fig.querySelector<HTMLElement>('.time b');
    const json = fig.querySelector('script[type="application/json"]');
    if (!video || !play || !track || !head || !hair || !hairText || !time || !json) continue;
    const { cues, track: path } = JSON.parse(json.textContent ?? '{}') as Data;
    const length = Number(fig.dataset.length) || 1;
    const srcW = Number(fig.dataset.w) || 1;
    const srcH = Number(fig.dataset.h) || 1;
    const media = fig.querySelector<HTMLElement>('.media');
    const box = fig.querySelector<HTMLElement>('.box');
    const boxLabel = box?.querySelector('b');
    const pin = fig.querySelector<HTMLElement>('.pin');
    const segs = [...fig.querySelectorAll<HTMLElement>('.seg')];
    const notes = [...fig.querySelectorAll<HTMLButtonElement>('.note')];
    const hasFrames = 'requestVideoFrameCallback' in HTMLVideoElement.prototype;
    let heldByUser = false;
    let scrubbing = false;
    let active = -2;
    let shown = '';

    const render = (t: number) => {
      head.style.transform = `translateX(${(Math.min(t, length) / length) * track.clientWidth}px)`;
      const label = clock(t);
      if (label !== shown) {
        time.textContent = label;
        track.setAttribute('aria-valuenow', t.toFixed(1));
        track.setAttribute('aria-valuetext', label);
        shown = label;
      }
      const i = cues.findIndex((c) => t >= c.from && t < c.to);
      const cue = cues[i];
      const rect: Box | null = cue ? (cue.box && cue.box[2] > 0 ? cue.box : cue.box ? null : path ? sample(path, t) : null) : null;
      const point = cue?.box && cue.box[2] === 0 ? cue.box : null;
      if (i !== active) {
        active = i;
        segs.forEach((s, j) => s.classList.toggle('on', j === i));
        notes.forEach((n, j) => n.classList.toggle('on', j === i));
        box?.classList.toggle('on', Boolean(rect));
        pin?.classList.toggle('on', Boolean(point));
        if (pin && point && media) {
          pin.style.setProperty('--tx', `${(point[0] / 100) * media.clientWidth}px`);
          pin.style.setProperty('--ty', `${(point[1] / 100) * media.clientHeight}px`);
          pin.textContent = String(i + 1);
        }
      }
      if (box && boxLabel && rect) {
        const [x, y, w, h] = rect;
        const mw = media?.clientWidth ?? 0;
        const mh = media?.clientHeight ?? 0;
        box.style.setProperty('--tx', `${(x / 100) * mw}px`);
        box.style.setProperty('--ty', `${(y / 100) * mh}px`);
        box.style.setProperty('--w', String(w));
        box.style.setProperty('--h', String(h));
        box.classList.toggle('low', y < 9);
        boxLabel.innerHTML = `${pad(i)}<span>${Math.round((w / 100) * srcW)}×${Math.round((h / 100) * srcH)}</span>`;
      }
    };

    const onFrame = (_: number, meta: VideoFrameCallbackMetadata) => {
      render(meta.mediaTime);
      if (!video.paused) video.requestVideoFrameCallback(onFrame);
    };
    const onRaf = () => {
      render(video.currentTime);
      if (!video.paused) requestAnimationFrame(onRaf);
    };

    const sync = () => {
      const playing = !video.paused;
      fig.toggleAttribute('data-playing', playing);
      play.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      play.dataset.tip = playing ? 'Pause' : 'Play';
      if (playing) {
        if (hasFrames) video.requestVideoFrameCallback(onFrame);
        else requestAnimationFrame(onRaf);
      }
    };

    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    video.addEventListener('seeked', () => {
      if (video.paused) render(video.currentTime);
    });

    const start = () => {
      video.play().catch(() => {});
    };
    const seek = (t: number) => {
      video.currentTime = Math.min(length, Math.max(0, t));
      render(video.currentTime);
    };

    play.addEventListener('click', () => {
      if (video.paused) {
        heldByUser = false;
        start();
      } else {
        heldByUser = true;
        video.pause();
      }
    });
    video.addEventListener('click', () => play.click());

    const ratio = (x: number) => {
      const r = track.getBoundingClientRect();
      return Math.min(1, Math.max(0, (x - r.left) / r.width));
    };
    const moveHair = (x: number) => {
      const k = ratio(x);
      hair.style.transform = `translateX(${k * track.clientWidth}px)`;
      hairText.textContent = clock(k * length);
    };

    track.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      track.toggleAttribute('data-hover', true);
      moveHair(e.clientX);
    });
    track.addEventListener('pointerleave', () => {
      if (!scrubbing) track.removeAttribute('data-hover');
    });
    track.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      scrubbing = true;
      track.setPointerCapture(e.pointerId);
      track.toggleAttribute('data-hover', true);
      moveHair(e.clientX);
      seek(ratio(e.clientX) * length);
    });
    track.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse' || scrubbing) moveHair(e.clientX);
      if (scrubbing) seek(ratio(e.clientX) * length);
    });
    const end = (e: PointerEvent) => {
      if (!scrubbing) return;
      scrubbing = false;
      if (e.pointerType !== 'mouse' || !fine.matches) track.removeAttribute('data-hover');
    };
    track.addEventListener('pointerup', end);
    track.addEventListener('pointercancel', end);
    track.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      seek(video.currentTime + (e.key === 'ArrowRight' ? 1 : -1) * (e.shiftKey ? 0.1 : 0.5));
    });

    notes.forEach((n, i) => {
      n.addEventListener('click', () => {
        seek(cues[i].from + 0.02);
        heldByUser = false;
        start();
      });
    });

    addEventListener('resize', () => {
      active = -2;
      render(video.currentTime);
    });

    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (!heldByUser && !reduced.matches) start();
        } else if (!video.paused) {
          video.pause();
        }
      },
      { threshold: 0.6 },
    ).observe(fig.querySelector('.stage') ?? fig);
  }
</script>

<style>
  .narrow .stage,
  .narrow .notes {
    max-width: 440px;
    margin-inline: auto;
  }

  .media .box,
  .media .pin {
    left: 0;
    top: 0;
    transform: translate(var(--tx, 0), var(--ty, 0));
  }

  .media .pin {
    transform: translate(var(--tx, 0), var(--ty, 0)) scale(0.8);
  }

  .media .pin.on {
    transform: translate(var(--tx, 0), var(--ty, 0));
  }

  .media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px 10px 10px;
    border-top: 1px solid var(--card-line);
  }

  .play {
    display: grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--stage);
    color: var(--strong);
    transition:
      transform 120ms var(--out),
      background-color 150ms ease;
  }

  .play:active {
    transform: scale(0.94);
  }

  .play .ic {
    grid-area: 1 / 1;
    width: 12px;
    height: 12px;
    transition: opacity 120ms ease;
  }

  .ic-pause,
  [data-playing] .ic-play {
    opacity: 0;
  }

  [data-playing] .ic-pause {
    opacity: 1;
  }

  .track {
    position: relative;
    flex: 1;
    height: 28px;
    cursor: pointer;
    touch-action: none;
  }

  .track:focus-visible {
    outline-offset: 0;
  }

  .rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 13px;
    height: 2px;
    border-radius: 2px;
    background: var(--line);
    transition: transform 150ms var(--out);
  }

  .seg {
    position: absolute;
    top: 0;
    height: 100%;
    border-radius: 2px;
    background: var(--accent);
    opacity: 0.35;
    transition: opacity 150ms ease;
  }

  .seg.on {
    opacity: 1;
  }

  .head {
    position: absolute;
    top: 8px;
    left: 0;
    width: 2px;
    height: 12px;
    margin-left: -1px;
    border-radius: 2px;
    background: var(--strong);
  }

  .hair {
    position: absolute;
    top: 5px;
    left: 0;
    width: 1px;
    height: 18px;
    background: var(--muted);
    opacity: 0;
    pointer-events: none;
    transition: opacity 100ms ease;
  }

  .hair span {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 0;
    transform: translateX(-50%);
    padding: 3px 5px;
    border-radius: 4px;
    background: var(--chip);
    color: var(--chip-ink);
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .track[data-hover] .hair {
    opacity: 1;
  }

  .time {
    min-width: 88px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .time b {
    font-weight: 400;
    color: var(--muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .track {
      cursor: crosshair;
    }

    .track:hover .rail {
      transform: scaleY(2);
    }

    .play:hover {
      background: var(--line);
    }
  }

  @media (max-width: 640px) {
    .note-t {
      display: none;
    }

    .time {
      min-width: 0;
    }
  }
</style>
