---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Cue {
  from: number;
  to: number;
  text: string;
  x?: number;
  y?: number;
  w?: number;
  h?: number;
}

interface Props {
  src: string;
  poster: ImageMetadata;
  label: string;
  length: number;
  cues?: Cue[];
  caption?: string;
  narrow?: boolean;
}

const { src, poster, label, length, cues = [], caption, narrow = false } = Astro.props;
const still = await getImage({ src: poster, format: 'webp', width: Math.min(poster.width, 1440) });
const pct = (n: number) => `${n}%`;
const clock = (s: number) => `0:${String(Math.floor(s)).padStart(2, '0')}`;
const at = (s: number) => Math.min(100, (s / length) * 100);
---

<figure class:list={['fig', 'clip', { narrow }]} data-clip data-length={length}>
  <div class="stage" style={{ aspectRatio: `${poster.width} / ${poster.height}` }}>
    <video muted playsinline loop preload="none" poster={still.src} aria-label={label}>
      <source src={src} type="video/mp4" />
    </video>
    {cues.map((c, i) =>
      c.x !== undefined && c.y !== undefined ? (
        <>
          {c.w && c.h && (
            <span
              class="ring"
              data-cue={i}
              style={{ left: pct(c.x), top: pct(c.y), width: pct(c.w), height: pct(c.h) }}
            />
          )}
          <span class="pin" data-cue={i} style={{ left: pct(c.x), top: pct(c.y) }} aria-hidden="true">
            {i + 1}
          </span>
        </>
      ) : null,
    )}
  </div>
  <div class="transport">
    <button type="button" class="play" aria-label="Play" data-play>
      <svg class="ic ic-play"><use href="#i-play"></use></svg>
      <svg class="ic ic-pause"><use href="#i-pause"></use></svg>
    </button>
    <div class="track">
      <span class="rail" aria-hidden="true"><span class="fill"></span></span>
      {cues.map((c, i) => (
        <button
          type="button"
          class="chapter"
          data-seek={c.from}
          data-until={c.to}
          data-cue={i}
          style={{ left: pct(at(c.from)), width: pct(at(c.to) - at(c.from)) }}
          aria-label={`Jump to ${clock(c.from)}: ${c.text}`}
        >
          <span class="chip">{i + 1}</span>
        </button>
      ))}
    </div>
    <span class="time" aria-hidden="true"><b>{clock(0)}</b> / {clock(length)}</span>
  </div>
  <figcaption>
    {cues.length > 0 && (
      <div class="now" aria-live="polite">
        <p class="line" data-rest data-on>
          <span class="hint">{cues.length} notes. Tap a number on the timeline to jump to one.</span>
        </p>
        {cues.map((c, i) => (
          <p class="line" data-line={i}>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <span>{c.text}</span>
          </p>
        ))}
      </div>
    )}
    {caption && <p class="cap">{caption}</p>}
  </figcaption>
</figure>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const clock = (t: number) => `0:${String(Math.floor(t)).padStart(2, '0')}`;

  for (const fig of document.querySelectorAll<HTMLElement>('[data-clip]')) {
    const video = fig.querySelector('video');
    const play = fig.querySelector<HTMLButtonElement>('[data-play]');
    const fill = fig.querySelector<HTMLElement>('.fill');
    const time = fig.querySelector<HTMLElement>('.time b');
    if (!video || !play || !fill || !time) continue;
    const length = Number(fig.dataset.length) || 1;
    const marks = fig.querySelectorAll<HTMLElement>('[data-cue]');
    const lines = fig.querySelectorAll<HTMLElement>('[data-line]');
    const rest = fig.querySelector<HTMLElement>('[data-rest]');
    const chapters = [...fig.querySelectorAll<HTMLElement>('[data-seek]')].map((b) => ({
      i: b.dataset.cue ?? '',
      from: Number(b.dataset.seek),
      to: Number(b.dataset.until),
    }));
    let heldByUser = false;
    let frame = 0;
    let shown = '';
    let active: string | null = null;

    const paint = () => {
      const t = video.currentTime;
      fill.style.transform = `scaleX(${Math.min(1, t / length)})`;
      const label = clock(t);
      if (label !== shown) {
        time.textContent = label;
        shown = label;
      }
      const on = chapters.find((c) => t >= c.from && t < c.to)?.i ?? '';
      if (on !== active) {
        active = on;
        for (const el of marks) el.classList.toggle('on', el.dataset.cue === on);
        for (const el of lines) el.toggleAttribute('data-on', el.dataset.line === on);
        rest?.toggleAttribute('data-on', on === '');
      }
      if (!video.paused) frame = requestAnimationFrame(paint);
    };

    const sync = () => {
      const playing = !video.paused;
      fig.toggleAttribute('data-playing', playing);
      play.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(paint);
    };

    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    video.addEventListener('seeked', () => requestAnimationFrame(paint));

    const start = () => {
      video.play().catch(() => {});
    };

    play.addEventListener('click', () => {
      if (video.paused) {
        heldByUser = false;
        start();
      } else {
        heldByUser = true;
        video.pause();
      }
    });

    for (const b of fig.querySelectorAll<HTMLButtonElement>('[data-seek]')) {
      b.addEventListener('click', () => {
        video.currentTime = Number(b.dataset.seek);
        heldByUser = false;
        start();
      });
    }

    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (!heldByUser && !still.matches) start();
        } else if (!video.paused) {
          video.pause();
        }
      },
      { threshold: 0.6 },
    ).observe(fig);
  }
</script>

<style>
  .stage {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    background: var(--stock);
    box-shadow: 0 0 0 1px var(--rule);
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ring {
    position: absolute;
    border: 2.5px solid var(--pink);
    border-radius: 10px 14px 9px 13px / 12px 9px 14px 10px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms var(--out);
  }

  .pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink-deep);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    box-shadow: 0 0 0 2px var(--stock);
    opacity: 0;
    transition: opacity 200ms var(--out);
  }

  .ring.on,
  .pin.on {
    opacity: 1;
  }

  .transport {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    margin-top: 12px;
  }

  .play {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--stock);
    transition: transform 160ms var(--out);
  }

  .play:active {
    transform: scale(0.97);
  }

  .play .ic {
    grid-area: 1 / 1;
    width: 15px;
    height: 15px;
    transition: opacity 140ms ease;
  }

  .ic-pause,
  [data-playing] .ic-play {
    opacity: 0;
  }

  [data-playing] .ic-pause {
    opacity: 1;
  }

  .track {
    position: relative;
    height: 30px;
    margin-left: 10px;
  }

  .rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    margin-top: -1.5px;
    background: var(--rule);
    overflow: hidden;
  }

  .fill {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  .chapter {
    position: absolute;
    top: 0;
    bottom: 0;
    min-width: 12px;
  }

  .chapter::before {
    content: "";
    position: absolute;
    left: 0;
    right: 2px;
    top: 50%;
    height: 7px;
    margin-top: -3.5px;
    border-radius: 1px;
    background: var(--pink-tint);
    transition: background-color 160ms ease;
  }

  .chapter.on::before {
    background: var(--pink);
  }

  .chip {
    position: absolute;
    top: 50%;
    left: 0;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink-deep);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    box-shadow: 0 0 0 2px var(--sheet);
  }

  .chapter:focus-visible {
    outline-offset: 2px;
  }

  .time {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .time b {
    font-weight: 500;
    color: var(--ink);
  }

  figcaption {
    display: grid;
    gap: 6px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
  }

  .now {
    display: grid;
  }

  .line {
    grid-area: 1 / 1;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    min-height: 22px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-deep);
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .line[data-on] {
    opacity: 1;
  }

  .hint {
    color: var(--ink-2);
  }

  .n {
    display: grid;
    flex: none;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink-deep);
    font-size: 11px;
    font-weight: 700;
  }

  .cap {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-2);
  }

  @media (hover: hover) and (pointer: fine) {
    .chapter:not(.on):hover::before {
      background: var(--pink);
    }
  }

  @media (max-width: 599px) {
    .pin {
      width: 22px;
      height: 22px;
      margin: -11px 0 0 -11px;
      font-size: 11px;
    }
  }
</style>
