---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Cue {
  from: number;
  to: number;
  text: string;
  x?: number;
  y?: number;
  w?: number;
  h?: number;
}

interface Props {
  src: string;
  poster: ImageMetadata;
  label: string;
  length: number;
  cues?: Cue[];
  caption?: string;
  narrow?: boolean;
}

const { src, poster, label, length, cues = [], caption, narrow = false } = Astro.props;
const still = await getImage({ src: poster, format: 'webp', width: Math.min(poster.width, 1440) });
const pct = (n: number) => `${n}%`;
const clock = (s: number) => `0:${String(Math.floor(s)).padStart(2, '0')}`;
---

<figure class:list={['fig', 'clip', { wide: !narrow }]} data-clip data-length={length}>
  <div class="stage" style={{ aspectRatio: `${poster.width} / ${poster.height}` }}>
    <video muted playsinline loop preload="none" poster={still.src} aria-label={label}>
      <source src={src} type="video/mp4" />
    </video>
    {cues.map((c, i) =>
      c.x !== undefined && c.y !== undefined ? (
        <>
          {c.w && c.h && (
            <span
              class="ring"
              data-cue={i}
              style={{ left: pct(c.x), top: pct(c.y), width: pct(c.w), height: pct(c.h) }}
            />
          )}
          <span class="pin" data-cue={i} style={{ left: pct(c.x), top: pct(c.y) }} aria-hidden="true">
            {i + 1}
          </span>
        </>
      ) : null,
    )}
  </div>
  <div class="bar">
    <button type="button" class="play" aria-label="Play" data-play>
      <svg class="ic ic-play"><use href="#i-play"></use></svg>
      <svg class="ic ic-pause"><use href="#i-pause"></use></svg>
    </button>
    <div class="track" aria-hidden="true">
      {cues.map((c) => (
        <span class="span" style={{ left: pct((c.from / length) * 100), width: pct(((c.to - c.from) / length) * 100) }} />
      ))}
      <span class="fill"></span>
    </div>
    <span class="time" aria-hidden="true">{clock(0)}</span>
  </div>
  {(cues.length > 0 || caption) && (
    <figcaption>
      {cues.length > 0 && (
        <ol class="cues">
          {cues.map((c, i) => (
            <li>
              <button type="button" data-seek={c.from} data-until={c.to} data-cue={i}>
                <span class="n" aria-hidden="true">{i + 1}</span>
                <span class="t">{clock(c.from)}</span>
                <span>{c.text}</span>
              </button>
            </li>
          ))}
        </ol>
      )}
      {caption && <p class="cap">{caption}</p>}
    </figcaption>
  )}
</figure>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  for (const fig of document.querySelectorAll<HTMLElement>('[data-clip]')) {
    const video = fig.querySelector('video');
    const play = fig.querySelector<HTMLButtonElement>('[data-play]');
    const fill = fig.querySelector<HTMLElement>('.fill');
    const time = fig.querySelector<HTMLElement>('.time');
    if (!video || !play || !fill || !time) continue;
    const length = Number(fig.dataset.length) || 1;
    const marks = fig.querySelectorAll<HTMLElement>('[data-cue]');
    const windows = [...fig.querySelectorAll<HTMLElement>('[data-seek]')].map((b) => ({
      i: b.dataset.cue ?? '',
      from: Number(b.dataset.seek),
      to: Number(b.dataset.until),
    }));
    let heldByUser = false;
    let frame = 0;
    let shown = '';

    const paint = () => {
      const t = video.currentTime;
      fill.style.transform = `scaleX(${Math.min(1, t / length)})`;
      const label = `0:${String(Math.floor(t)).padStart(2, '0')}`;
      if (label !== shown) {
        time.textContent = label;
        shown = label;
      }
      const on = new Set(windows.filter((w) => t >= w.from && t < w.to).map((w) => w.i));
      for (const el of marks) el.classList.toggle('on', on.has(el.dataset.cue ?? ''));
      if (!video.paused) frame = requestAnimationFrame(paint);
    };

    const sync = () => {
      const playing = !video.paused;
      fig.toggleAttribute('data-playing', playing);
      play.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(paint);
    };

    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    video.addEventListener('seeked', () => requestAnimationFrame(paint));

    const start = () => {
      video.play().catch(() => {});
    };

    play.addEventListener('click', () => {
      if (video.paused) {
        heldByUser = false;
        start();
      } else {
        heldByUser = true;
        video.pause();
      }
    });

    for (const b of fig.querySelectorAll<HTMLButtonElement>('[data-seek]')) {
      b.addEventListener('click', () => {
        video.currentTime = Number(b.dataset.seek);
        heldByUser = false;
        start();
      });
    }

    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (!heldByUser && !still.matches) start();
        } else if (!video.paused) {
          video.pause();
        }
      },
      { threshold: 0.6 },
    ).observe(fig);
  }
</script>

<style>
  .stage {
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 0 1.5px var(--ink);
    background: var(--stock);
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ring {
    position: absolute;
    border: 2.5px solid var(--pink);
    border-radius: 10px 14px 9px 13px / 12px 9px 14px 10px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms var(--out);
  }

  .pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink-deep);
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 0 0 2px var(--stock);
    opacity: 0;
    transition: opacity 200ms var(--out);
  }

  .ring.on,
  .pin.on {
    opacity: 1;
  }

  .bar {
    display: grid;
    grid-template-columns: 40px 1fr 5ch;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
  }

  .play {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 3px;
    color: var(--ink);
    transition:
      background-color 160ms ease,
      transform 160ms var(--out);
  }

  .play:active {
    transform: scale(0.97);
  }

  .play .ic {
    grid-area: 1 / 1;
    transition: opacity 140ms ease;
  }

  .ic-pause,
  [data-playing] .ic-play {
    opacity: 0;
  }

  [data-playing] .ic-pause {
    opacity: 1;
  }

  .track {
    position: relative;
    height: 6px;
    background: var(--rule);
  }

  .span {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--pink-tint);
  }

  .fill {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  .time {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  figcaption {
    display: grid;
    gap: 12px;
    margin-top: 12px;
  }

  .cues {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    align-items: start;
    gap: 2px 20px;
    padding: 0;
    list-style: none;
  }

  .cues button {
    display: grid;
    grid-template-columns: 22px 4ch 1fr;
    gap: 10px;
    align-items: start;
    width: calc(100% + 16px);
    padding: 6px 8px;
    margin: 0 -8px;
    border-radius: 3px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.5;
    text-align: left;
    transition: background-color 160ms ease;
  }

  .cues button.on {
    background: var(--pink-tint);
    color: var(--ink-deep);
  }

  .n {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink-deep);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }

  .t {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .cap {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-2);
  }

  @media (hover: hover) and (pointer: fine) {
    .play:hover,
    .cues button:not(.on):hover {
      background: var(--hover);
    }
  }

  @media (max-width: 599px) {
    .pin {
      width: 22px;
      height: 22px;
      margin: -11px 0 0 -11px;
      font-size: 11px;
    }
  }
</style>
