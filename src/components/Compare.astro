---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  beforeLabel: string;
  afterLabel: string;
  caption?: string;
  start?: number;
}

const { before, after, beforeAlt, afterAlt, beforeLabel, afterLabel, caption, start = 50 } =
  Astro.props;
const sizes = '(max-width: 660px) 100vw, 620px';
---

<figure class="fig compare">
  <div class="stage">
    <div class="stage-in">
      <div class="cmp" style={{ '--pos': `${start}%` }} data-compare>
        <Picture src={after} alt={afterAlt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1280]} sizes={sizes} />
        <div class="before">
          <Picture src={before} alt={beforeAlt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1280]} sizes={sizes} />
        </div>
        <span class="handle" aria-hidden="true"><span class="grip"></span></span>
        <span class="lab lab-b" aria-hidden="true">{beforeLabel}</span>
        <span class="lab lab-a" aria-hidden="true">{afterLabel}</span>
        <input
          type="range"
          min="0"
          max="100"
          step="0.5"
          value={start}
          aria-label={`Slide between ${beforeLabel} and ${afterLabel}`}
        />
      </div>
    </div>
  </div>
  {caption && <figcaption class="cap">{caption}</figcaption>}
</figure>

<script>
  for (const cmp of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    const input = cmp.querySelector('input');
    input?.addEventListener('input', () => cmp.style.setProperty('--pos', `${input.value}%`));
  }
</script>

<style>
  .cmp {
    position: relative;
    overflow: hidden;
    touch-action: pan-y;
  }

  .cmp :global(img) {
    width: 100%;
    height: auto;
  }

  .before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .handle {
    position: absolute;
    inset: 0;
    transform: translateX(var(--pos));
    pointer-events: none;
  }

  .handle::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -0.75px;
    width: 1.5px;
    background: var(--accent);
  }

  .grip {
    position: absolute;
    top: 50%;
    left: -13px;
    width: 26px;
    height: 26px;
    margin-top: -13px;
    border-radius: 50%;
    background: var(--handle);
    box-shadow:
      0 0 0 1.5px var(--accent),
      0 2px 6px rgb(0 0 0 / 0.18);
    transition: transform 150ms var(--out);
  }

  .grip::before,
  .grip::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 0;
    height: 0;
    margin-top: -4px;
    border-block: 4px solid transparent;
  }

  .grip::before {
    left: 6px;
    border-right: 4px solid var(--accent);
  }

  .grip::after {
    right: 6px;
    border-left: 4px solid var(--accent);
  }

  .lab {
    position: absolute;
    top: 10px;
    padding: 3px 6px;
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.3;
    pointer-events: none;
    background: var(--chip);
    color: var(--chip-ink);
  }

  .lab-b {
    left: 10px;
  }

  .lab-a {
    right: 10px;
    background: var(--accent);
    color: var(--accent-ink);
  }

  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .cmp:has(input:active) .grip {
    transform: scale(1.08);
  }

  .cmp:has(input:focus-visible) .grip {
    box-shadow:
      0 0 0 1.5px var(--accent),
      0 0 0 4px var(--accent-soft);
  }
</style>
