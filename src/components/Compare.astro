---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  beforeLabel: string;
  afterLabel: string;
  caption?: string;
  start?: number;
}

const { before, after, beforeAlt, afterAlt, beforeLabel, afterLabel, caption, start = 50 } =
  Astro.props;
const sizes = '(min-width: 1400px) 1320px, calc(100vw - 32px)';
---

<figure class="fig compare wide">
  <div class="cmp" style={{ '--pos': `${start}%` }} data-compare>
    <Picture src={after} alt={afterAlt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1320, 1920]} sizes={sizes} />
    <div class="before">
      <Picture src={before} alt={beforeAlt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1320, 1920]} sizes={sizes} />
    </div>
    <span class="handle" aria-hidden="true"></span>
    <span class="lab lab-b" aria-hidden="true">{beforeLabel}</span>
    <span class="lab lab-a" aria-hidden="true">{afterLabel}</span>
    <input
      type="range"
      min="0"
      max="100"
      step="0.5"
      value={start}
      aria-label={`Slide between ${beforeLabel} and ${afterLabel}`}
    />
  </div>
  {caption && <figcaption class="cap">{caption}</figcaption>}
</figure>

<script>
  for (const cmp of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    const input = cmp.querySelector('input');
    input?.addEventListener('input', () => cmp.style.setProperty('--pos', `${input.value}%`));
  }
</script>

<style>
  .cmp {
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 0 1.5px var(--ink);
    touch-action: pan-y;
  }

  .cmp :global(img) {
    width: 100%;
    height: auto;
  }

  .before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 3px;
    margin-left: -1.5px;
    background: var(--pink);
    pointer-events: none;
  }

  .handle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 0 2px var(--stock);
  }

  .lab {
    position: absolute;
    top: 12px;
    padding: 3px 7px 2px;
    border-radius: 2px;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.4;
    pointer-events: none;
  }

  .lab-b {
    left: 12px;
    background: var(--stock);
    color: var(--ink-deep);
  }

  .lab-a {
    right: 12px;
    background: var(--ink);
    color: var(--stock);
  }

  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .cmp:has(input:focus-visible) .handle::after {
    box-shadow:
      0 0 0 2px var(--stock),
      0 0 0 4px var(--ink);
  }

  .cap {
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-2);
  }
</style>
