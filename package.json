{
  "name": "blogspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check && astro check",
    "check:fix": "biome check --write",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.14",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "simple-git-hooks@2.14.0": true
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no -- biome check --staged --no-errors-on-unmatched || { echo 'Biome found issues in staged files. Run: npm run check:fix, then git add and commit again.'; exit 1; }"
  },
  "engines": {
    "node": ">=22.12"
  }
}
